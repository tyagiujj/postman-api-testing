          "name": "GetRequestDay2Param",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const posts = pm.response.json();\r\n\r\npm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Response is an array\", function () {\r\n    pm.expect(posts).to.be.an(\"array\");\r\n});\r\n\r\npm.test(\"There are 10 posts\", function () {\r\n    pm.expect(posts).to.have.lengthOf(10);\r\n});\r\n\r\npm.test(\"Every post belongs to the selected user\", function () {\r\n    const expectedUser = Number(pm.environment.get(\"userId\"));\r\n    posts.forEach(function (post) {\r\n        pm.expect(post.userId).to.equal(expectedUser);\r\n    });\r\n});"
                ]
              }
            }
          ],
