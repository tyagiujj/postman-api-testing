      "name": "CRUD flow",
      "item": [
        {
          "name": "1 Create post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\nconst data = pm.response.json();\r\n\r\npm.test(\"Response has an id\", function () {\r\n    pm.expect(data).to.have.property(\"id\");\r\n});\r\n\r\npm.test(\"id is a number\", function () {\r\n    pm.expect(data.id).to.be.a(\"number\");\r\n});\r\n\r\npm.test(\"userId matches the environment\", function () {\r\n    const expectedUser = Number(pm.environment.get(\"userId\"));\r\n    pm.expect(data.userId).to.equal(expectedUser);\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"title\": \"Post number {{$randomInt}}\",\r\n  \"body\": \"Created at {{$timestamp}}\",\r\n  \"userId\": {{userId}}\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ]
            }
          },
          "response": []
        },
        {
          "name": "2 Read post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\npm.test(\"Response time is below 1000 ms\", function () {\r\n    pm.expect(pm.response.responseTime).to.be.below(1000);\r\n});\r\n\r\npm.test(\"Content-Type is JSON\", function () {\r\n    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");\r\n});\r\nconst data = pm.response.json();\r\n\r\npm.test(\"Post id is 1\", function () {\r\n    pm.expect(data.id).to.equal(1);\r\n});\r\n\r\npm.test(\"Post has all four fields\", function () {\r\n    pm.expect(data).to.have.property(\"userId\");\r\n    pm.expect(data).to.have.property(\"id\");\r\n    pm.expect(data).to.have.property(\"title\");\r\n    pm.expect(data).to.have.property(\"body\");\r\n});\r\n\r\npm.test(\"Data types are correct\", function () {\r\n    pm.expect(data.id).to.be.a(\"number\");\r\n    pm.expect(data.title).to.be.a(\"string\");\r\n});\r\n\r\npm.test(\"Title is not empty\", function () {\r\n    pm.expect(data.title).to.not.equal(\"\");\r\n});\r\nconsole.log(\"Title is:\", data.title);\r\nconsole.log(\"Response time is:\", pm.response.responseTime);\r\nconsole.log(\"Full body:\", data);"
                ]
              }
            }
          ],
